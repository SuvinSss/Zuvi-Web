# Copy to .env and set real local values. .env is gitignored — never commit it.
# This example holds placeholders only — no real secrets, no production credentials.
#
# Generate a local secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as f; print(f())"

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LOCAL_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://zuvi@127.0.0.1:5432/zuvi_dev
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=False

# Local defaults. Hosted development/uat/production use real environment variables
# and do not read .env. All hosted environments require DJANGO_DEBUG=False.
DJANGO_ENVIRONMENT=local
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
DJANGO_STATIC_ROOT=staticfiles

# Gunicorn reads exported process variables, not .env. PORT below is only an
# example for local Gunicorn usage; Railway supplies its runtime PORT.
WEB_CONCURRENCY=1
PORT=8000

# Local media stays on disk. Hosted environments must explicitly set s3 and
# supply their OWN bucket and credentials; never put real credentials in Git.
MEDIA_STORAGE_BACKEND=filesystem
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_BUCKET_NAME=example-dev-media
# MEDIA_REGION_NAME=ap-south-1
# MEDIA_ACCESS_KEY_ID=EXAMPLE_ONLY
# MEDIA_SECRET_ACCESS_KEY=EXAMPLE_ONLY
