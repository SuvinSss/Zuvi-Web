# Copy to .env and set real local values. .env is gitignored — never commit it.
# This example holds placeholders only — no real secrets, no production credentials.
#
# Generate a local secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as f; print(f())"

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LOCAL_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://zuvi@127.0.0.1:5432/zuvi_dev
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=False
