# Copy to .env and set real local values. .env is gitignored — never commit it.
# This example holds placeholders only — no real secrets, no production credentials.
#
# Generate a local secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as f; print(f())"

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LOCAL_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://zuvi@127.0.0.1:5432/zuvi_dev
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=False

# --- Google Maps Platform -------------------------------------------------------
# Use TWO separate keys. Never put the server key in the React app or in any
# browser-visible setting. See docs/google-maps-platform-setup.md.
#
# Browser key: restrict by HTTP referrer (localhost for development, your real
# domains elsewhere) and to Maps JavaScript API + Places API (New) only.
# GOOGLE_MAPS_API_KEY is the older name and is still read as the browser key.
GOOGLE_MAPS_BROWSER_API_KEY=
# Server key: used only by Django for Geocoding API, Routes API (and optionally
# Address Validation API). Restrict by the server's outbound IP and by those APIs.
GOOGLE_MAPS_SERVER_API_KEY=
# A vector Map ID created in Google Cloud (required for advanced markers).
# DEMO_MAP_ID works for local testing only; create a real one for deployment.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
GOOGLE_MAPS_REGION=IN
GOOGLE_MAPS_LANGUAGE=en
# TWO_WHEELER or DRIVE. Confirm the mode is supported for your region in the Routes docs.
GOOGLE_ROUTES_TRAVEL_MODE=TWO_WHEELER
GOOGLE_HTTP_TIMEOUT_SECONDS=5
# Seconds a route may be reused to avoid duplicate paid requests. 0 turns it off.
GOOGLE_ROUTES_CACHE_TTL_SECONDS=600
GOOGLE_ADDRESS_VALIDATION_ENABLED=False

# Delivery quotes. Leave False until stores have confirmed pins, a pricing
# version exists, and customers check out through the React app. When True,
# delivery orders require a valid server quote.
DELIVERY_QUOTES_ENFORCED=False
DELIVERY_QUOTE_TTL_SECONDS=900

# Per-user request limits on endpoints that call paid Google APIs.
THROTTLE_GEO_GEOCODE=30/min
THROTTLE_GEO_ROUTE=30/min
THROTTLE_GEO_QUOTE=20/min
THROTTLE_GEO_ADMIN=20/min
THROTTLE_GEO_PUBLIC=60/min
THROTTLE_AUTH_LOGIN=10/min

# Local defaults. Hosted development/uat/production use real environment variables
# and do not read .env. All hosted environments require DJANGO_DEBUG=False.
DJANGO_ENVIRONMENT=local
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
DJANGO_STATIC_ROOT=staticfiles

# Gunicorn reads exported process variables, not .env. PORT below is only an
# example for local Gunicorn usage; Railway supplies its runtime PORT.
WEB_CONCURRENCY=1
PORT=8000

# Local media stays on disk. Hosted environments must explicitly set s3 and
# supply their OWN bucket and credentials; never put real credentials in Git.
MEDIA_STORAGE_BACKEND=filesystem
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_BUCKET_NAME=example-dev-media
# MEDIA_REGION_NAME=ap-south-1
# MEDIA_ACCESS_KEY_ID=EXAMPLE_ONLY
# MEDIA_SECRET_ACCESS_KEY=EXAMPLE_ONLY

# Optional Google sign-in. Configure the exact /customer/login/google/callback/
# HTTPS URI for each environment in the Google OAuth web client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Customer password recovery: outbound email must be configured before use.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ZuuVi <noreply@zuuvi.in>
