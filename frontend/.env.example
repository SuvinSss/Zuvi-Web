# Leave empty to use the Vite dev proxy (recommended: same-origin session cookie).
# Or set a full URL (and add that origin to DJANGO_CORS_ALLOWED_ORIGINS and
# DJANGO_CSRF_TRUSTED_ORIGINS on the backend), e.g. https://api.example.com/api/v1
VITE_API_BASE_URL=
# Where `npm run dev` proxies /api and /media.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000

# Google map on the website (optional). A BROWSER key restricted to your site's referrers and the
# Maps JavaScript API only — not the server key. Empty = OpenStreetMap map.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Optional Map ID (Google Maps Platform → Map Management) for a styled map.
VITE_GOOGLE_MAPS_MAP_ID=
