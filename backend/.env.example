# Copy to .env and set real local values. .env is gitignored — never commit it.
# This example holds placeholders only — no real secrets, no production credentials.
#
# Generate a local secret key:
#   python -c "from django.core.management.utils import get_random_secret_key as f; print(f())"

DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_LOCAL_KEY
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://zuvi@127.0.0.1:5432/zuvi_dev
DB_CONN_MAX_AGE=0
DB_SSL_REQUIRE=False

# Google Maps (see docs/google-maps-setup.md). SERVER key only: restricted to your server's IP
# and to Places API (New), Geocoding API and Routes API. Never put it in frontend/.env.
# Leave empty to run without Google (OpenStreetMap map, estimated distances).
GOOGLE_MAPS_SERVER_KEY=
# Website map key (Maps JavaScript API only, restricted to your site's referrers). Public by design; this is
# NOT the server key. Served to the site at run time, so no frontend rebuild is needed. Optional Map ID too.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
LOCATION_GEOCODER=none
LOCATION_ROUTER=none
# GOOGLE_ROUTES_TRAVEL_MODE=TWO_WHEELER
# LOCATION_PROVIDER_TIMEOUT=5
# Require a manager to confirm each store's map pin before it can take delivery orders (default off)
# STORE_PIN_CONFIRMATION_REQUIRED=False
# API_THROTTLE_MAPS_CHECK=10/hour

# Local defaults. Hosted development/uat/production use real environment variables
# and do not read .env. All hosted environments require DJANGO_DEBUG=False.
DJANGO_ENVIRONMENT=local
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_LOG_LEVEL=INFO
DJANGO_STATIC_ROOT=staticfiles

# Gunicorn reads exported process variables, not .env. PORT below is only an
# example for local Gunicorn usage; Railway supplies its runtime PORT.
WEB_CONCURRENCY=1
PORT=8000

# Local media stays on disk. Hosted environments must explicitly set s3 and
# supply their OWN bucket and credentials; never put real credentials in Git.
MEDIA_STORAGE_BACKEND=filesystem
# MEDIA_STORAGE_BACKEND=s3
# MEDIA_BUCKET_NAME=example-dev-media
# MEDIA_REGION_NAME=ap-south-1
# MEDIA_ACCESS_KEY_ID=EXAMPLE_ONLY
# MEDIA_SECRET_ACCESS_KEY=EXAMPLE_ONLY

# Customer password recovery: outbound email must be configured before use.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ZuuVi <noreply@zuuvi.in>

# --- API / React admin ---
# Local-only SQLite fallback when DATABASE_URL is unset (hosted environments require PostgreSQL).
# SQLITE_PATH=data/zuvi.sqlite3
# Only needed when the React app is served from a different origin than Django.
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_SESSION_COOKIE_AGE=1209600
# API_THROTTLE_USER=600/min
# API_THROTTLE_LOGIN=10/min
# API_THROTTLE_IMPORT=30/hour
